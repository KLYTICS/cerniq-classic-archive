# Production E2E credentials — copy to .env.production-e2e.local (gitignored).
# Usage: set -a && source .env.production-e2e.local && set +a

CERNIQ_API_URL=https://api.cerniq.io
CERNIQ_FRONTEND_URL=https://cerniq.io

# Bearer token for QA workspace user (no "Bearer " prefix).
CERNIQ_E2E_JWT=

# Cooperativa demo institution in QA workspace.
CERNIQ_E2E_INSTITUTION_ID=

# Optional: second tenant JWT for RLS negative test.
CERNIQ_E2E_CROSS_JWT=

# Optional: filter GET /api/alm/institutions
CERNIQ_E2E_WORKSPACE_ID=

# Optional: enables health-check admin stats section
ADMIN_KEY=

# Optional: prod Postgres URL for `prisma migrate status` in Phase 0
# DATABASE_URL=

# Never set unless founder explicitly wants automated billing smoke
# CERNIQ_E2E_RUN_BILLING=0
