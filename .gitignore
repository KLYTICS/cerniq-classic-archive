docker-compose.override.yml

# Python — services/cossec-parser only (the sole remaining Python surface)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
.pytest_cache/

# Backend Node
/backend-node/node_modules/
/backend-node/dist/
/backend-node/coverage/

# Foreign-product trees removed in the 2026-08-12 CerniQ-only cleanup.
# Kept as ignore rules so a stale checkout or an unpacked backup can never
# re-enter the index the way /archive/ did (it was ignored but still TRACKED,
# so the rule was inert and 116 MB of Rust target/ artifacts rode along).
/archive/
/crates/
/backend/
/platform/
/projects/
/aegis/
/services/outbound/
/infrastructure/
/migrations/
/workspace/
/output/
/test_data/

# Git worktrees (never track sibling worktree contents)
/Cerniq-*/

# Data cache
/data/*.parquet
/data/*.csv
/data/gtm-runs/*
!/data/gtm-runs/.gitkeep
/data/cooperativa-directory/*
!/data/cooperativa-directory/.gitkeep
*.parquet

# Temporary files
tmp/
temp/
*.tmp
.vercel

# Firebase
firebase-debug.log

# Local IDE + agent runtime state (per-developer, never commit)
.cursor/
.claude/
