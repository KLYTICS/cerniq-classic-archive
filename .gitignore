/frontend/e2e/a11y-sweep/.auth/
/apple/.build/
/apple/.swiftpm/
/dist/

# Word/docx source drops (authoritative copies live in docs/ as .md)
*.docx

# OMX runtime state (intentionally local, not source-controlled)
/.omx/
/.omx/metrics.json
/.omx/state/*.json
/.omx/state/**/*.json

